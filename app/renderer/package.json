{
  "name": "wai-renderer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:hex": "! grep -rnE '#[0-9A-Fa-f]{3,8}\\b' src --include=*.ts --include=*.tsx --include=*.css | grep -v '^src/theme/'"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.0.0",
    "@fontsource/ibm-plex-sans-thai": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
