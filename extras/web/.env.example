# Data source: "mock" (default, in-memory seeded data + live simulation) or "supabase"
WAI_DATA=mock

# 1 = with WAI_DATA=mock, start the in-memory store EMPTY: no seeded people, no history, no simulation.
# Only real registrations and wais appear. /health reports mode "real-only"; the badge shows REAL ONLY.
# Ignored when WAI_DATA=supabase (no mock rows exist there).
WAI_BLOCK_MOCK=

# Required when WAI_DATA=supabase. Server-only — never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
