{
  "manifest_version": 3,
  "name": "hwAI Web Guard",
  "version": "0.1.0",
  "description": "ตรวจจับการส่งพรอมต์ในเว็บ AI (Claude, ChatGPT, Gemini) แล้วแจ้ง hwAI daemon บนเครื่อง โดยไม่อ่านหรือส่งข้อความ",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:7777/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["logic.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "hwAI Web Guard", "default_popup": "popup.html" }
}
